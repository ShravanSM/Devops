#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y python3 python3-pip

mkdir -p /opt/assignment/flask

echo '${flask_app_b64}' | base64 -d > /opt/assignment/flask/app.py
echo '${flask_req_b64}' | base64 -d > /opt/assignment/flask/requirements.txt

python3 -m venv /opt/assignment/flask/venv
/opt/assignment/flask/venv/bin/pip install -r /opt/assignment/flask/requirements.txt

cat >/etc/systemd/system/assignment-flask.service <<'EOF'
[Unit]
Description=Assignment Flask Demo
After=network.target

[Service]
WorkingDirectory=/opt/assignment/flask
ExecStart=/opt/assignment/flask/venv/bin/python /opt/assignment/flask/app.py
Restart=always

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now assignment-flask